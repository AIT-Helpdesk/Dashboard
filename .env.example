# Quote values that contain special characters (#, $, etc.) so dotenv doesn't truncate them.
AUTOTASK_USERNAME=your_api_user@example.com
AUTOTASK_SECRET='your_api_secret'
AUTOTASK_INTEGRATION_CODE=your_integration_code
PORT=3000

# Microsoft 365 (Entra ID) sign-in -- see README.md "Securing the dashboard"
# for how to create the app registration these come from.
AUTH_CLIENT_ID=your_entra_app_client_id
AUTH_CLIENT_SECRET='your_entra_app_client_secret'
AUTH_TENANT_ID=your_entra_tenant_id
# Must exactly match the app registration's Redirect URI, minus "/auth/callback".
# Use the real address other people reach this box at -- NOT localhost, once
# it's shared on the network.
APP_BASE_URL=http://your-server-address:3000
# Random long string, e.g. `openssl rand -hex 32` -- signs the session cookie.
SESSION_SECRET='replace_with_a_long_random_string'
# Optional: comma-separated exact email addresses to further narrow who can
# sign in, on top of the tenant restriction. Leave unset to allow anyone in
# the tenant who can authenticate (subject to the app registration's own
# "Assignment required" setting, if you turn that on in Entra).
AUTH_ALLOWED_USERS=

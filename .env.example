# Quote values that contain special characters (#, $, etc.) so dotenv doesn't truncate them.
AUTOTASK_USERNAME=your_api_user@example.com
AUTOTASK_SECRET='your_api_secret'
AUTOTASK_INTEGRATION_CODE=your_integration_code
PORT=3000

# Microsoft 365 (Entra ID) sign-in -- see README.md "Securing the dashboard"
# for how to create the app registration these come from. There is
# deliberately no APP_BASE_URL here -- the redirect URI and cookie security
# are derived from each request's own Host header (packages/shell/auth.js),
# not a fixed value, since this app is reached at more than one address at
# once (localhost:3000 directly, and the real dashboard domain via Caddy).
# Every address it's reached at still needs its own Redirect URI registered
# in Entra (Authentication -> Web platform -> Add URI).
AUTH_CLIENT_ID=your_entra_app_client_id
AUTH_CLIENT_SECRET='your_entra_app_client_secret'
AUTH_TENANT_ID=your_entra_tenant_id
# Random long string, e.g. `openssl rand -hex 32` -- signs the session cookie.
SESSION_SECRET='replace_with_a_long_random_string'
# Optional: comma-separated exact email addresses to further narrow who can
# sign in, on top of the tenant restriction. Leave unset to allow anyone in
# the tenant who can authenticate (subject to the app registration's own
# "Assignment required" setting, if you turn that on in Entra).
AUTH_ALLOWED_USERS=

# CSP Customers page (packages/csp-customers) -- a SEPARATE Entra app
# registration from the dashboard's own sign-in app above, registered
# directly in your CSP tenant via Partner Center's own "App management" page
# (Settings -> Account settings -> App management), not just the Azure
# Portal -- see that page's README for why. Used for app-only Microsoft
# Graph access (Contract.Read.All), NOT the Partner Center REST API, which
# doesn't support Indirect Reseller accounts at all.
CSP_CLIENT_ID=your_csp_app_client_id
CSP_CLIENT_SECRET='your_csp_app_client_secret'
CSP_TENANT_ID=your_csp_tenant_id

# Shifts and Schedules page (packages/teams-shifts) -- another SEPARATE Entra app
# registration, this one in Ambient IT's own tenant (TEAMS_SHIFTS_TENANT_ID
# will usually match AUTH_TENANT_ID below). App-only Microsoft Graph access
# (Group.Read.All + Schedule.Read.All + User.Read.All, all admin-consented),
# NOT the dashboard's own sign-in app -- see that page's README for why.
TEAMS_SHIFTS_CLIENT_ID=your_teams_shifts_app_client_id
TEAMS_SHIFTS_CLIENT_SECRET='your_teams_shifts_app_client_secret'
TEAMS_SHIFTS_TENANT_ID=your_teams_shifts_tenant_id

# Datto RMM page (packages/datto-rmm) -- Datto RMM API v2. DATTO_API_URL is
# from your Datto user profile (region-specific, e.g. syrah/pinotage/merlot/
# concord/vidal/zinfandel -api.centrastage.net). DATTO_API_SECRET is
# optional -- some tenants use key-only (bearer) auth; set it if your key
# was generated with a paired secret (Setup -> Users -> API Keys).
DATTO_API_URL=https://syrah-api.centrastage.net
DATTO_API_KEY=your_datto_api_key
DATTO_API_SECRET=your_datto_api_secret

# Voice Scheduler page (packages/voice-scheduler) -- an Azure OpenAI
# resource with TWO deployments: a whisper model (speech-to-text) and a
# small chat model (e.g. gpt-4o-mini, for turning a spoken transcript into
# calendar-event fields and follow-up questions). See that page's own
# README for the full "why". Also needs the dashboard's own Entra app
# registration (AUTH_CLIENT_ID above) granted the Calendars.ReadWrite
# delegated Graph permission with admin consent -- see root README.md
# "Securing the dashboard".
AZURE_OPENAI_KEY=your_azure_openai_resource_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# IT Glue API -- generated under IT Glue's own Account Settings -> API Keys.
# Region matters: IT Glue has separate hosts per region (api.itglue.com,
# api.eu.itglue.com, api.au.itglue.com) -- confirmed against the real
# account this dashboard is for, api.au.itglue.com.
ITGLUE_API_KEY=your_itglue_api_key
ITGLUE_API_BASE=https://api.au.itglue.com

# Admin Full Access -- comma-separated exact Entra ID display names (NOT
# emails), same matching as AUTH_ALLOWED_USERS is NOT (that one IS emails --
# this is the one deliberate departure). The single source of truth for
# every "only Amber" gate across the dashboard (packages/shell/registry.js's
# isDashboardAdmin/isAdminFullAccess) -- the sidebar layout editor, TC Elite
# Rollout's Add Column/Add Stage, Contract Checks' Edit Template, What's
# On's automation status banner, the Strety automation reconnect flow, and
# always bypasses every MENUCATEGORY_ list below too.
ADMIN_FULL_ACCESS=Amber Worth

# Tracker Manager -- comma-separated exact Entra ID display names (NOT
# emails, unlike AUTH_ALLOWED_USERS above) allowed to create a new rollout
# tracker, add a column to one, and move one between Trackers / Trackers -
# Complete (packages/rollout-tracker-builder, packages/shell/rollout-
# tracker-*.js). Matched case-insensitively against req.session.user.name
# (MSAL's own account.name -- see packages/shell/rollout-tracker-
# permissions.js for the full reasoning). Adding a row to an existing
# tracker stays open to everyone signed in, no gate at all.
TRACKER_MANAGER=Amber Worth, Jackson Worth

# Menu Category access -- restricts a sidebar category (and everything
# under it) to exactly the people listed, on top of ADMIN_FULL_ACCESS above
# who always see everything regardless. The variable name is
# MENUCATEGORY_ followed by the category's own id (see
# packages/shell/nav-layout.json), uppercased with hyphens turned to
# underscores -- e.g. the "trackers-complete" category maps to
# MENUCATEGORY_TRACKERS_COMPLETE below, "testing" to MENUCATEGORY_TESTING.
# A category with NO matching env var here keeps its plain hidden:true
# sidebar behaviour, unchanged -- this only takes over for a category
# that's actually listed. Add more lines here, in this exact
# MENUCATEGORY_<ID> shape, to restrict any other category -- no code
# change needed (packages/shell/registry.js's categoryAccessFor).
#
# Three special forms, checked once at startup (registry.js's
# reconcileEnvCategories, needs a restart to take effect -- .env is only
# read at process start):
#   - A MENUCATEGORY_<ID> naming a category that doesn't exist yet CREATES
#     an empty one (label derived from the id's own words) at the root of
#     the sidebar -- drag it into place afterward same as any builder's
#     freshly-published page. Works no matter what the value is.
#   - value = DELETE removes that category, but ONLY if it's currently
#     empty (no pages in it) -- a category with real pages is left alone,
#     never force-deleted.
#   - value left blank means "no individual lockdown needed, allow
#     everyone" -- the category still exists/gets created, just isn't
#     restricted to anyone in particular (and is never shown dimmed as
#     "(hidden)" the way a plain hidden:true category is to a non-admin).
#   - value = ADMIN ONLY (exact, case-insensitive) restricts the category
#     to ADMIN_FULL_ACCESS above and nobody else, spelled out explicitly
#     rather than relying on the plain hidden:true fallback.
MENUCATEGORY_TRACKERS_COMPLETE=Amber Worth, Jackson Worth, Damon Kirkpatrick
MENUCATEGORY_TESTING=Amber Worth, Dechen Choden

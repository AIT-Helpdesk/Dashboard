node_modules/
.env
*.log
logs/
server.pid

# Strety OAuth tokens -- real bearer credentials for whichever Strety
# account connected, persisted to disk so the connection survives a
# restart (see packages/strety-client/index.js). Never committed.
packages/strety-client/.tokens.json

# Same reasoning, for the separate limited-access Strety connection the
# Autotask -> Strety automation uses (see packages/strety-autotask-sync) --
# deliberately a DIFFERENT token file from the main connection above, never
# committed either.
packages/strety-autotask-sync/.tokens.json

# Same reasoning again, for each signed-in dashboard user's OWN personal
# Strety connection (see @dashboard/strety-client's getPersonalClient()) --
# one file per person, all real bearer credentials, none of them committed.
packages/strety-client/.personal-tokens/

# Runtime state (last sync.js run's outcome), not a credential, but not
# checked in either -- see packages/strety-autotask-sync/status.js.
packages/strety-autotask-sync/last-run.json

# Same reasoning, for Report Ingest's own runtime state (which SharePoint
# items have already been processed, plus the last run's own result) -- see
# packages/meeting-prep/ingest.js.
packages/meeting-prep/ingest-state.json

# TC Elite Rollout's own SQLite database -- real, live application data
# (client rollout statuses, the full audit trail), not source, never
# committed. WAL mode (see db.js) also creates -shm/-wal sidecar files
# alongside the main one.
packages/tc-elite-rollout/data.db
packages/tc-elite-rollout/data.db-shm
packages/tc-elite-rollout/data.db-wal

# Same reasoning, for Workshop's own SQLite database (real workshop job
# data, not source).
packages/workshop/data.db
packages/workshop/data.db-shm
packages/workshop/data.db-wal

# Same reasoning, for Goods Received's own SQLite database (real
# delivery-log data, not source).
packages/packages-received/data.db
packages/packages-received/data.db-shm
packages/packages-received/data.db-wal

# Same reasoning, for Contract Checks' own SQLite database (synced Ingram
# order data plus real checklist state, not source).
packages/contract-checks/data.db
packages/contract-checks/data.db-shm
packages/contract-checks/data.db-wal

# Same reasoning, for Updates' own SQLite database (real changelog entries,
# not source).
packages/updates/data.db
packages/updates/data.db-shm
packages/updates/data.db-wal

# Same reasoning, for every tracker generated by Rollout Tracker Builder
# (packages/rollout-tracker-builder) -- each gets its own real, live
# data.db (rows/columns/cell statuses/audit trail) and notes.json (its own
# free-form Notes field content, see rollout-tracker-server.js), neither
# of which is source. A wildcard rather than hardcoded lines like the ones
# above -- generated tracker folder names are dynamic (<slug>-tracker),
# decided at publish time, not known in advance.
packages/*-tracker/data.db
packages/*-tracker/data.db-shm
packages/*-tracker/data.db-wal
packages/*-tracker/notes.json

# Meeting Prep's own report data (packages/meeting-prep/data/) -- real,
# live client report content (parsed Datto RMM/Dark Web ID PDFs), not
# source, and not expected to live in git long-term: once the automated
# SharePoint pickup job (see data/README.md) exists, each environment
# regenerates/receives its own copy independently, the same way every
# *-tracker's data.db above is real data rather than source. Until then,
# moved between environments by hand (dev -> production) rather than via
# git. data/README.md itself (documentation, not client data) stays
# tracked -- hence excluding contents one level down rather than the
# whole data/ directory.
packages/meeting-prep/data/*
!packages/meeting-prep/data/README.md
